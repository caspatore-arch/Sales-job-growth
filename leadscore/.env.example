# ---------------------------------------------------------------------------
# leadscore environment variables
# Copy to .env and fill in. In --dry-run mode none of these are required;
# every paid API is mocked with realistic fake data.
# ---------------------------------------------------------------------------

# Google Places API (New) — https://console.cloud.google.com/
# Enable "Places API (New)" and create an API key.
GOOGLE_PLACES_API_KEY=

# Hunter.io — https://hunter.io/api-keys (used only when no email is found on-site)
HUNTER_API_KEY=

# Twilio Lookup — https://console.twilio.com/  (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Anthropic (Claude Haiku) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional override; defaults to a current Haiku model.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Supabase — project URL + service role key (server-side writes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Table to write qualified leads into (created by you; see README for schema).
SUPABASE_TABLE=leads
